"""One complete linear Python workflow per dataset; JSON is the only rule output."""

import subprocess
from pathlib import Path

from apb_studio.corpus import oddities
from apb_studio.corpus.models import RunManifest
from apb_studio.corpus.runs import command_for, dataset_dependencies, publish_index
from apb_studio.corpus.tables import load_corpus

if not workflow.configfiles:
    raise ValueError("Pass the generated run.json using --configfile")

ROOT = Path(workflow.configfiles[-1]).resolve().parent
RUN = RunManifest.model_validate_json((ROOT / "run.json").read_text())
BY_KEY = {Path(link.path).stem: link for link in RUN.reports}
BY_INPUT = {row.input_file: row for row in load_corpus(ROOT / RUN.corpus)}


rule all:
    input:
        index=str(ROOT / "corpus_index.json"),
        oddities=str(ROOT / "oddities.json"),


rule dataset:
    input:
        dependencies=lambda wc: dataset_dependencies(
            ROOT, RUN, BY_INPUT[BY_KEY[wc.key].input_file], BY_KEY[wc.key]
        )
    output:
        str(ROOT / "reports/{key}.json")
    params:
        command=lambda wc: command_for(ROOT, RUN, BY_KEY[wc.key]),
        dataset=lambda wc: BY_INPUT[BY_KEY[wc.key].input_file].model_dump_json(),
        tool_versions=tuple(sorted(RUN.tool_versions.items())),
    run:
        subprocess.run(params.command, check=True)


rule index:
    input:
        reports=[str(ROOT / link.path) for link in RUN.reports],
        projection=str(Path(oddities.__file__)),
    output:
        index=str(ROOT / "corpus_index.json"),
        oddities=str(ROOT / "oddities.json"),
    run:
        publish_index(ROOT, RUN)
